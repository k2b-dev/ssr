{
  "name": "ssr-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun run --filter @k2b/ssr test",
    "test:all": "bun run --filter '*' test",
    "dev:example": "bun run --filter ssr-example dev",
    "build:example": "bun run --filter ssr-example build",
    "start:example": "bun run --filter ssr-example start"
  },
  "packageManager": "bun@1.4.2"
}
